#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Cython debug symbols
cython_debug

# Cookiecutter
#  https://cookiecutter.readthedocs.io/en/latest/readme.html
cookiecutter-repo

# Output of 'numpy test'
#  These contents will be deleted with 'make realclean'
#  (to be added by the numpy test makefile, see later in the file).
